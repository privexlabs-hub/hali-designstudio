{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/commercial/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/review/**",
              "design_handoff_hali/ui_kits/agency-app/**",
              "ui_kits/agency-app/**",
              "ui_kits/client-portal/**",
              "ui_kits/marketing/**",
              "ui_kits/patterns/**",
              "ui_kits/public-page/**",
              "ui_kits/shared/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:actor|action|target|time|meta|kind|key|ref|className|style|children)$/]",
        "message": "<ActivityItem> doesn't accept that prop. Declared props: actor, action, target, time, meta, kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:decision|system|ai|note|problem)$/]",
        "message": "<ActivityItem> kind must be one of 'decision' | 'system' | 'ai' | 'note' | 'problem'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgencyMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|logoSrc|color|size|showName|nameStyle|key|ref|className|style|children)$/]",
        "message": "<AgencyMark> doesn't accept that prop. Declared props: name, logoSrc, color, size, showName, nameStyle."
      },
      {
